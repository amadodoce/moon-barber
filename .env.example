# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Zarinpal payment gateway ───────────────────────────────────────────────
# Local development (mock gateway — no real Zarinpal calls):
#   ZARINPAL_DEV_MOCK=true
#   ZARINPAL_SANDBOX=true
#   ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"  # any 36-char string in sandbox
#   CALLBACK_URL="http://localhost:3000/api/payment/callback"
#   NEXT_PUBLIC_BASE_URL="http://localhost:3000"
#
# Deployed sandbox on Vercel (real Zarinpal sandbox API):
#   ZARINPAL_DEV_MOCK=false
#   ZARINPAL_SANDBOX=true
#   ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
#   CALLBACK_URL="https://your-domain.vercel.app/api/payment/callback"
#   NEXT_PUBLIC_BASE_URL="https://your-domain.vercel.app"
#
# Production:
#   ZARINPAL_DEV_MOCK=false
#   ZARINPAL_SANDBOX=false
#   ZARINPAL_MERCHANT_ID="your-real-36-char-merchant-id"
#   CALLBACK_URL="https://your-domain.com/api/payment/callback"

ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX="true"
ZARINPAL_DEV_MOCK="true"
CALLBACK_URL="http://localhost:3000/api/payment/callback"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
